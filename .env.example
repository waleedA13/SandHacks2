# Copy to .env.local and fill in real values. Never commit .env.local.
# List every variable the app needs here, with a dummy value or empty.

# Neon Postgres connection string (pooled)
DATABASE_URL=

# Bright Data: account API key, zone names, and the Browser API wss:// URL
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker
BRIGHTDATA_SERP_ZONE=serp_api
BRIGHTDATA_BROWSER_WSS=

# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# ElevenLabs API key and the confirm-call agent's ID. Both are server-only:
# /api/voice/token uses them to issue short-lived tokens. No NEXT_PUBLIC_ prefix.
ELEVENLABS_API_KEY=
NEXT_ELEVENLABS_AGENT_ID=

# Twilio API key (SID starts with SK) and its secret
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Shared secret ElevenLabs sends with call results; generate with: openssl rand -hex 32
CALLS_WEBHOOK_SECRET=

# Real phone calls (issue #17): the Twilio number's id in ElevenLabs (phnum_...), and
# the only phones /api/calls/start may ring, as comma-separated E.164 with no spaces.
# Teammates' phones only. Empty means every number is refused.
ELEVENLABS_PHONE_NUMBER_ID=
DEMO_CALL_ALLOWLIST=

# ElevenLabs patient helper agent's ID (issue #16). Server-only, like the
# confirm agent: /api/voice/token issues its token when the body is
# { "agent": "helper" }. No NEXT_PUBLIC_ prefix.
NEXT_ELEVENLABS_HELPER_AGENT_ID=
